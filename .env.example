# Supabase: project URL and publishable/anon key (server-side session client).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required for username login and checking username availability.
# Keep this secret on the server; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key used only by POST /api/generate-recipe.
AI_MODEL_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional: Pexels API key enables recipe photo search and attribution.
PEXELS_API_KEY=
