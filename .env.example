# Supabase: project URL and publishable/anon key (server-side session client).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required for username login and checking username availability.
# Keep this secret on the server; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider configuration for POST /api/generate-recipe.
# This project runs only with Google Gemini.
# AI_MODELS can contain multiple fallback models separated by commas.
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-3.6-flash
AI_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-2.0-flash
AI_MODEL_API_KEY=

# Optional: Pixabay API key enables recipe photo search and attribution.
PIXABAY_API_KEY=
